{
  "name": "querylens-java",
  "displayName": "QueryLens for Java",
  "description": "See the SQL queries your Spring Boot endpoints really execute.",
  "version": "0.1.2",
  "publisher": "suedasen",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/querylens.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuedaSen/querylens-java.git"
  },
  "homepage": "https://github.com/SuedaSen/querylens-java#readme",
  "bugs": {
    "url": "https://github.com/SuedaSen/querylens-java/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "galleryBanner": {
    "color": "#4B32C3",
    "theme": "dark"
  },
  "keywords": [
    "java",
    "spring boot",
    "hibernate",
    "jdbc",
    "sql",
    "n+1",
    "performance"
  ],
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:queryLens.requests",
    "onCommand:queryLens.loadDemo",
    "onCommand:queryLens.clear",
    "onCommand:queryLens.runSpringBoot",
    "onCommand:queryLens.openSource",
    "onCommand:queryLens.openTutorial",
    "onCommand:queryLens.showTrace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "queryLens.loadDemo",
        "title": "QueryLens: Load Demo Trace",
        "icon": "$(beaker)"
      },
      {
        "command": "queryLens.clear",
        "title": "QueryLens: Clear Traces",
        "icon": "$(clear-all)"
      },
      {
        "command": "queryLens.runSpringBoot",
        "title": "QueryLens: Run Spring Boot with Agent",
        "icon": "$(play)"
      },
      {
        "command": "queryLens.openSource",
        "title": "QueryLens: Open Query Source"
      },
      {
        "command": "queryLens.openTutorial",
        "title": "QueryLens: Open Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "queryLens.showTrace",
        "title": "QueryLens: Show Request Details"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "queryLens",
          "title": "QueryLens",
          "icon": "resources/querylens.svg"
        }
      ]
    },
    "views": {
      "queryLens": [
        {
          "id": "queryLens.requests",
          "name": "Request Traces"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "queryLens.requests",
        "contents": "No requests captured yet.\n\n[Run Spring Boot with QueryLens](command:queryLens.runSpringBoot)\n\nCall one of your endpoints, then select the request to open its visual dashboard.\n\n[Preview the dashboard](command:queryLens.loadDemo)\n\n[Open the tutorial](command:queryLens.openTutorial)"
      }
    ],
    "walkthroughs": [
      {
        "id": "queryLens.gettingStarted",
        "title": "Get started with QueryLens",
        "description": "Run a Spring Boot application and find its hidden query costs.",
        "steps": [
          {
            "id": "queryLens.openProject",
            "title": "Open a Spring Boot project",
            "description": "Open the folder containing a Spring Boot `pom.xml` or `build.gradle`. QueryLens supports Spring Boot 3, Spring MVC, Hibernate, and JDBC."
          },
          {
            "id": "queryLens.startApplication",
            "title": "Start with the QueryLens agent",
            "description": "Run [QueryLens: Run Spring Boot with Agent](command:queryLens.runSpringBoot). QueryLens starts the project and connects its bundled local Java agent.",
            "completionEvents": [
              "onCommand:queryLens.runSpringBoot"
            ]
          },
          {
            "id": "queryLens.sendRequest",
            "title": "Call an application endpoint",
            "description": "Use your browser, REST client, or terminal to send an HTTP request to the running application. The request will appear automatically in the QueryLens sidebar."
          },
          {
            "id": "queryLens.inspectResults",
            "title": "Inspect the trace",
            "description": "Select a request to open its dashboard. Expand it to see SQL statements and N+1 warnings. Select a query to jump to its Java source line."
          }
        ]
      }
    ],
    "configuration": {
      "title": "QueryLens",
      "properties": {
        "queryLens.collectorPort": {
          "type": "number",
          "default": 4318,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port used to receive traces from the QueryLens Java agent."
        },
        "queryLens.nPlusOneThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 100,
          "description": "Number of repeated queries required before QueryLens reports a possible N+1 issue."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "queryLens.loadDemo",
          "when": "view == queryLens.requests",
          "group": "navigation"
        },
        {
          "command": "queryLens.clear",
          "when": "view == queryLens.requests",
          "group": "navigation"
        },
        {
          "command": "queryLens.runSpringBoot",
          "when": "view == queryLens.requests",
          "group": "navigation@1"
        },
        {
          "command": "queryLens.openTutorial",
          "when": "view == queryLens.requests",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
